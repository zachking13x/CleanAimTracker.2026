<Window x:Class="CleanAimTracker.Windows.RoutineSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session complete"
        Width="720" Height="700"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="28 24 28 22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 18">
            <TextBlock x:Name="HeadlineText" Text="Session complete"
                       FontSize="24" FontWeight="Black"
                       Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock x:Name="SubtitleText" Text=""
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedText}"
                       Margin="0 4 0 0"/>
        </StackPanel>

        <!-- Session totals -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}"
                CornerRadius="12" Padding="20 16" Margin="0 0 0 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DrillsText" Text="0" FontSize="26" FontWeight="Black"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="drills" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="AccuracyText" Text="0%" FontSize="26" FontWeight="Black"
                               Foreground="#00D4FF"/>
                    <TextBlock Text="avg accuracy" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="26" FontWeight="Black"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="total score" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="TimeText" Text="0m" FontSize="26" FontWeight="Black"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="trained" FontSize="10" Foreground="{DynamicResource MutedText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Per-drill breakdown -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DrillList"/>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0 16 0 0">
            <TextBlock x:Name="CoachNoteText" Text=""
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedText}"
                       Margin="0 0 0 12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FullReportBtn" Content="See the full coach report"
                        Click="FullReport_Click"
                        Height="38" Padding="18 0" Margin="0 0 8 0" Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryText}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1"/>
                <Button Content="Done" Click="Close_Click"
                        Height="38" Padding="28 0" Cursor="Hand"
                        BorderThickness="0" Foreground="Black">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#00D4FF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
