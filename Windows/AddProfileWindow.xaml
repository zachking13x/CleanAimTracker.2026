<Window x:Class="CleanAimTracker.Windows.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Profile"
        Height="460"
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Add New Profile"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 6"/>

            <TextBlock Text="Enter the settings you actually use in that game. cm/360 is how far your mouse travels for one full turn — measure it in game, or copy it from your existing profile."
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       Margin="0 0 0 18"/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Profile Name:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="DPI:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="DpiBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Sensitivity:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="SensBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="cm / 360:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="Cm360Box" Width="300"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Foreground="#E0574A"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="120 0 0 12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 8 0 0">
                <Button Content="Save"
                        Width="100"
                        Margin="0 0 10 0"
                        Click="Save_Click"/>
                <Button Content="Cancel"
                        Width="100"
                        Click="Cancel_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
