<Window x:Class="CleanAimTracker.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460"
        Height="480"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        Icon="{StaticResource AppLogo}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                Padding="24 18"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0 0 0 1">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"
                           MouseLeftButtonDown="DevFunnel_Tap"/>
                <TextBlock Text="Customize your Clean Aim Tracker experience"
                           FontSize="12"
                           Foreground="{DynamicResource MutedText}"
                           Margin="0 4 0 0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24 20">
            <StackPanel>

                <!-- Mouse Settings -->
                <TextBlock Text="MOUSE SETTINGS"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Mouse DPI"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Your hardware DPI setting"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" Margin="0 2 0 0"/>
                        </StackPanel>
                        <TextBox x:Name="DpiInput"
                                 Grid.Column="1"
                                 Height="34"
                                 FontSize="14"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource InputText}"
                                 BorderBrush="{DynamicResource InputBorder}"
                                 BorderThickness="1"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="In-Game Sensitivity"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Default sensitivity value"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" Margin="0 2 0 0"/>
                        </StackPanel>
                        <TextBox x:Name="SensitivityInput"
                                 Grid.Column="1"
                                 Height="34"
                                 FontSize="14"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource InputText}"
                                 BorderBrush="{DynamicResource InputBorder}"
                                 BorderThickness="1"/>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Theme"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Light or dark interface"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" Margin="0 2 0 0"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeSelector"
                                  Grid.Column="1"
                                  Height="34"
                                  FontSize="13">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Sound -->
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Sound effects"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Hit and miss feedback while you train"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" Margin="0 2 0 0"/>
                        </StackPanel>
                        <CheckBox x:Name="SoundToggle" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryText}"/>
                    </Grid>
                </Border>

                <!-- CAT_SESSION_REPORT: the escape hatch back to report-after-every-drill -->
                <TextBlock Text="COACHING"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="16" Margin="0 0 0 20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Coach report after every drill"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Off by default — you get one line between drills and a full report when you finish training. Turn this on to open the full report after every single drill instead."
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0 2 8 0"/>
                        </StackPanel>
                        <CheckBox x:Name="ReportEveryDrillToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource PrimaryText}"/>
                    </Grid>
                </Border>

                <!-- Notifications -->
                <TextBlock Text="NOTIFICATIONS"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Training reminders"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Streak warnings, daily challenge, and a nudge if you drift — at most one a day."
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0 2 8 0"/>
                            </StackPanel>
                            <CheckBox x:Name="NotificationsToggle"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource PrimaryText}"/>
                        </Grid>
                        <TextBlock x:Name="NotificationsOsWarning"
                                   Visibility="Collapsed"
                                   Foreground="#FFAA44"
                                   FontSize="11" TextWrapping="Wrap" Margin="0 10 0 0"
                                   Text="Windows currently has notifications off for Clean Aim Tracker. Turn them on in Windows Settings → Notifications to receive reminders."/>
                    </StackPanel>
                </Border>

                <!-- CAT_TELEMETRY: privacy. Hidden entirely when no analytics endpoint is
                     configured — a toggle for something the build cannot do is a lie. -->
                <StackPanel x:Name="PrivacySection" Visibility="Collapsed">
                    <TextBlock Text="PRIVACY"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0 0 0 10"/>
                    <Border Background="{DynamicResource CardBackground}"
                            CornerRadius="10" Padding="16" Margin="0 0 0 20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Share anonymous usage data"
                                               Foreground="{DynamicResource PrimaryText}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Which drills get played and whether features are used — so I can fix what isn't working. Never your scores, accuracy, sensitivity, or anything that identifies you."
                                               Foreground="{DynamicResource MutedText}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0 2 8 0"/>
                                </StackPanel>
                                <CheckBox x:Name="TelemetryToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource PrimaryText}"/>
                            </Grid>
                            <TextBlock Foreground="{DynamicResource MutedText}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0 10 0 0"
                                       Text="Turning this off also erases the random ID this install was using."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Feedback -->
                <TextBlock Text="FEEDBACK"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 20">
                    <StackPanel>
                        <TextBlock Text="Got a request or found something off? Tell me — I read these."
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0 0 0 12" LineHeight="18"/>
                        <Button x:Name="FeedbackButton"
                                Content="Send feedback / Request a feature"
                                Click="Feedback_Click"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="Black" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Padding="14,8" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Privacy -->
                <TextBlock Text="PRIVACY"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="10" FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="10" Padding="18" Margin="0 0 0 6">
                    <StackPanel>
                        <TextBlock Text="Your data stays on this PC"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0 0 0 8"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="12" LineHeight="20">
Clean Aim Tracker stores all data locally — nothing is sent to any server or cloud service. The app records mouse movement metrics (speed, smoothness, flick counts), session timestamps, your DPI and sensitivity settings, and Aim Trainer drill results.

All data is saved in your Windows app data folder. Uninstalling the app removes it completely. No account or internet connection is required.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                Padding="24 16"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0 1 0 0">
            <Grid>
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        HorizontalAlignment="Left"
                        Width="90" Height="36"
                        Background="Transparent"
                        Foreground="{DynamicResource MutedText}"
                        FontSize="13"
                        BorderThickness="1"
                        BorderBrush="#444"
                        Cursor="Hand"/>
                <Button Content="Save Settings"
                        Click="SaveButton_Click"
                        HorizontalAlignment="Right"
                        Width="140" Height="36"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="Black"
                        FontSize="13"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
