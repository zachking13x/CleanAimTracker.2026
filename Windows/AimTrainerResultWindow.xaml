<Window x:Class="CleanAimTracker.Windows.AimTrainerResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drill Results"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="680" Height="720"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource AppBackground}"
            CornerRadius="14"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="14 14 0 0"
                    Padding="24 18">
                <!-- TASK-4.3: headline and score live in SEPARATE grid columns —
                     a 2-line headline can no longer flow underneath the score.
                     TASK-0.2: NO ellipsis on the verdict line — the headline
                     wraps to two FULL lines; templates carry a ≤110-char budget
                     so two lines always fit at default size. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 16 0">
                        <TextBlock x:Name="HeadlineText"
                                   Text="Drill Complete"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"
                                   LineHeight="26"/>
                        <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                            <Border x:Name="RatingBadge"
                                    Background="#1A00D4FF"
                                    CornerRadius="4"
                                    Padding="8 3"
                                    Margin="0 0 10 0">
                                <TextBlock x:Name="RatingText"
                                           Text="--"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="ScenarioBadgeText"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Score -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SCORE"
                                   Foreground="{DynamicResource MutedText}"
                                   FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreText"
                                   Text="0"
                                   FontSize="36" FontWeight="Black"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ BODY ═══ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24 16">
                <StackPanel>

                    <!-- STATS ROW -->
                    <Grid Margin="0 0 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                                CornerRadius="8" Padding="12 10" Margin="0 0 8 0">
                            <StackPanel>
                                <TextBlock Text="ACCURACY" Foreground="{DynamicResource MutedText}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AccuracyText" Text="--"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBackground}"
                                CornerRadius="8" Padding="12 10" Margin="0 0 8 0">
                            <StackPanel>
                                <!-- TASK-0.3: label set from code — "AVG REACTION" only for
                                     stimulus-anchored scenarios, else "AVG TIME/TARGET". -->
                                <TextBlock x:Name="AvgReactionLabel" Text="AVG REACTION" Foreground="{DynamicResource MutedText}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AvgReactionText" Text="--"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                                CornerRadius="8" Padding="12 10" Margin="0 0 8 0">
                            <StackPanel>
                                <TextBlock x:Name="BestReactionLabel" Text="BEST REACTION" Foreground="{DynamicResource MutedText}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BestReactionText" Text="--"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentGreen}"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{DynamicResource CardBackground}"
                                CornerRadius="8" Padding="12 10">
                            <StackPanel>
                                <TextBlock Text="BEST STREAK" Foreground="{DynamicResource MutedText}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StreakText" Text="--"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="Gold"
                                           Margin="0 4 0 0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hits / Misses bar -->
                    <Border Background="{DynamicResource CardBackground}"
                            CornerRadius="8" Padding="16 12" Margin="0 0 0 20">
                        <StackPanel>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="HITS vs MISSES"
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="10" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="HitsText" Foreground="{DynamicResource AccentGreen}"
                                               FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" hits  " Foreground="{DynamicResource MutedText}" FontSize="12"/>
                                    <TextBlock x:Name="MissesText" Foreground="{DynamicResource AccentOrange}"
                                               FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" misses" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#1AFFFFFF" CornerRadius="4" Height="8">
                                <Border x:Name="AccuracyBar"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4" Height="8"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ CAT_ACTIVE_FIX: the prescription as a PLAN with a finish line ═══
                         The coach opened a loop ("work on X") and verified it silently.
                         The user never saw how long it would take or when they were done,
                         so it never felt like a program — just recurring criticism. -->
                    <Border x:Name="ActiveFixCard"
                            Background="#14F5C842"
                            BorderBrush="#55F5C842"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,13"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="YOUR ACTIVE FIX"
                                           Foreground="{StaticResource AccentGold}"
                                           FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="ActiveFixProgressText"
                                           Text=""
                                           HorizontalAlignment="Right"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedText}"/>
                            </Grid>
                            <TextBlock x:Name="ActiveFixTitleText"
                                       Text=""
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Border Background="#1AFFFFFF" CornerRadius="3" Height="6"/>
                                <Border x:Name="ActiveFixBar"
                                        Background="{StaticResource AccentGold}"
                                        CornerRadius="3" Height="6"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="ActiveFixMetricText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ CAT_BENCHMARK_DESTINATION: where you stand + the next rung ═══
                         FREE for everyone, always visible, never displaceable. This is the
                         answer to "…compared to what?" that the coach never gave. -->
                    <Border x:Name="BenchmarkCard"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="#3300D4FF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,13"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="WHERE YOU STAND"
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BenchmarkTierText"
                                           Text=""
                                           HorizontalAlignment="Right"
                                           FontSize="14" FontWeight="Black"
                                           Foreground="{StaticResource AccentGold}"/>
                            </Grid>

                            <!-- ladder: entry → intermediate → high-int → advanced -->
                            <Grid Margin="0,0,0,6">
                                <Border Background="#1AFFFFFF" CornerRadius="4" Height="8"/>
                                <Border x:Name="BenchmarkBar"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4" Height="8"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="entry" FontSize="9" Foreground="{DynamicResource MutedText}"/>
                                <TextBlock Text="intermediate" FontSize="9" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedText}"/>
                                <TextBlock Text="advanced" FontSize="9" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedText}"/>
                            </Grid>

                            <TextBlock x:Name="BenchmarkNextText"
                                       Text=""
                                       FontSize="13"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="BenchmarkFootnote"
                                       Text="Voltaic-derived thresholds for this scenario type and difficulty."
                                       FontSize="9"
                                       Foreground="{DynamicResource MutedText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ TASK-16: Personal Best badges ═══ -->
                    <WrapPanel x:Name="PBBadgesPanel"
                               Margin="0,0,0,12"
                               Visibility="Collapsed"/>

                    <!-- ═══ PB CELEBRATION BANNER — gold, delayed fade-in ═══ -->
                    <Border x:Name="PBBanner"
                            Background="#1AF5C842"
                            BorderBrush="{StaticResource AccentGold}"
                            BorderThickness="0 0 0 2"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,16"
                            Opacity="0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PBBannerTitle"
                                           Text="NEW PERSONAL BEST!"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGold}"/>
                                <TextBlock x:Name="PBBannerDetail"
                                           Text=""
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ REVIEW PROMPT — PB-triggered, light & dismissible (CAT_REVIEW_PROMPT) ═══ -->
                    <Border x:Name="ReviewPromptBox" Visibility="Collapsed"
                            Background="#142BD4FF"
                            BorderBrush="{StaticResource AccentGold}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Text="New personal best — nice work. If Clean Aim Tracker's helping, a quick rating goes a long way for a solo dev. No worries if not."/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="⭐ Rate it" Click="RateIt_Click"
                                        Background="{StaticResource AccentGold}" Foreground="Black"
                                        FontWeight="Bold" BorderThickness="0" Padding="14,7" Cursor="Hand"/>
                                <Button Content="Maybe later" Click="MaybeLater_Click"
                                        Background="Transparent" Foreground="{DynamicResource MutedText}"
                                        BorderBrush="#444" BorderThickness="1" Padding="14,7"
                                        Margin="10,0,0,0" Cursor="Hand"/>
                                <Button Content="Don't ask again" Click="DontAskAgain_Click"
                                        Background="Transparent" Foreground="{DynamicResource MutedText}"
                                        FontSize="11" BorderThickness="0" Padding="8,7"
                                        Margin="6,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ XP PANEL ═══ -->
                    <Border x:Name="XpPanel"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <!-- T0.3: neutral placeholder, not "+0 XP" — ShowXpAsync
                                         fills it within a frame; a false zero must never flash. -->
                                    <TextBlock x:Name="XpEarnedText"
                                               Text="…"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGold}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="XpLevelText"
                                           Text="LEVEL 1"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- XP progress bar -->
                            <Border Background="{DynamicResource BgElevated}"
                                    CornerRadius="4" Height="6">
                                <Border x:Name="XpProgressBar"
                                        Background="{StaticResource AccentGold}"
                                        CornerRadius="4" Height="6"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>
                            <!-- Level-up banner — revealed on level-up -->
                            <Border x:Name="LevelUpBanner"
                                    Margin="0,10,0,0"
                                    Background="#1AF5C842"
                                    BorderBrush="{StaticResource AccentGold}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6"
                                    Padding="10,9"
                                    Opacity="0"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⬆  " FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGold}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LevelUpText"
                                               Text="LEVEL UP!"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGold}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ NEAR-MISS ACHIEVEMENT HINT ═══ -->
                    <Border x:Name="NearMissPanel"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="#22F5C842"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,14"
                            Visibility="Collapsed"
                            Opacity="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NearMissText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ TASK-17: Top 5 Sessions ═══ -->
                    <Border x:Name="Top5Panel"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="8" Padding="16,12"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="Top5HeaderText"
                                       Text="TOP 5 — SCENARIO"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <ItemsControl x:Name="Top5List">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RankDisplay}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DateDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource LabelText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AccuracyDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource LabelText}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ReactionDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource LabelText}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ScoreDisplay}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ AI COACHING SECTION ═══ -->
                    <Border x:Name="CoachingPanel"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="10"
                            BorderBrush="#1A00D4FF"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0 0 0 16">
                        <StackPanel>

                            <!-- Loading state -->
                            <StackPanel x:Name="CoachingLoading" Visibility="Visible">
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                                    <TextBlock Text="🤖  " FontSize="16"/>
                                    <TextBlock Text="AI COACH" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Analyzing your drill..."
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="13" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Free session banner — TASK-14 -->
                            <Border x:Name="FreeSessionBanner"
                                    Background="#14000000"
                                    BorderBrush="#4000E5A0"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,10"
                                    Margin="0,0,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="FreeSessionBannerTitle"
                                               Text="Full coaching report — everything unlocked."
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#00E5A0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FreeSessionBannerBody"
                                               Text="Your opening drills come fully coached, so you can see exactly what Pro does. Nothing held back."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Loaded state -->
                            <StackPanel x:Name="CoachingContent" Visibility="Collapsed">

                                <StackPanel Orientation="Horizontal" Margin="0 0 0 14">
                                    <TextBlock Text="🤖  " FontSize="16"/>
                                    <TextBlock Text="AI COACH" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- ═══ YOUR AIM — cross-session player profile (COACH_AIM_PROFILE) ═══ -->
                                <StackPanel x:Name="AimProfileSection" Margin="0 0 0 16" Visibility="Collapsed">
                                    <TextBlock Text="🎯  YOUR AIM"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11" FontWeight="Bold"
                                               Margin="0 0 0 6"/>
                                    <Border Background="#1400D4FF" CornerRadius="8"
                                            BorderBrush="#3300D4FF" BorderThickness="1"
                                            Padding="14 12">
                                        <StackPanel>
                                            <TextBlock x:Name="AimProfileCondensed"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       LineHeight="19"/>
                                            <Expander x:Name="AimProfileExpander"
                                                      Header="See full aim profile"
                                                      Foreground="{DynamicResource AccentBrush}"
                                                      FontSize="12" FontWeight="SemiBold"
                                                      Margin="0 10 0 0">
                                                <StackPanel Margin="0 8 0 0">
                                                    <ItemsControl x:Name="AimProfileFullList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource PrimaryText}"
                                                                           FontSize="13" TextWrapping="Wrap"
                                                                           Margin="0 0 0 8" LineHeight="19"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock x:Name="AimProfileRecomputeCaption"
                                                               Foreground="{DynamicResource MutedText}"
                                                               FontSize="11" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0 6 0 0"/>
                                                    <TextBlock x:Name="AimProfileGameDisclaimer"
                                                               Foreground="{DynamicResource MutedText}"
                                                               FontSize="11" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0 8 0 0"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Weaknesses — TASK-07: leads before Strengths -->
                                <StackPanel x:Name="WeaknessesSection">
                                <TextBlock Text="⚠️  AREAS TO IMPROVE"
                                           Foreground="#FFAA44"
                                           FontSize="11" FontWeight="Bold"
                                           Margin="0 0 0 6"/>
                                <ItemsControl x:Name="WeaknessesList" Margin="0 0 0 14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       Margin="0 0 0 6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <!-- Strengths — TASK-2.2: wrapped so an empty list collapses its header -->
                                <StackPanel x:Name="StrengthsSection">
                                <TextBlock Text="✅  STRENGTHS"
                                           Foreground="{DynamicResource AccentGreen}"
                                           FontSize="11" FontWeight="Bold"
                                           Margin="0 0 0 6"/>
                                <ItemsControl x:Name="StrengthsList" Margin="0 0 0 14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       FontSize="13" TextWrapping="Wrap"
                                                       Margin="0 0 0 6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <!-- Advice -->
                                <StackPanel x:Name="AdviceSection">
                                <TextBlock Text="💡  COACHING TIPS"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"
                                           Margin="0 0 0 6"/>
                                <ItemsControl x:Name="AdviceList" Margin="0 0 0 14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0A00D4FF" CornerRadius="6"
                                                    Padding="10 8" Margin="0 0 0 6">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           FontSize="13" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <!-- Next drill -->
                                <StackPanel x:Name="NextDrillSection">
                                <Border Background="#0A4CAF50" CornerRadius="6" Padding="12 10" Margin="0 0 0 12">
                                    <StackPanel>
                                        <TextBlock Text="NEXT DRILL SUGGESTION"
                                                   Foreground="{DynamicResource AccentGreen}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Margin="0 0 0 4"/>
                                        <TextBlock x:Name="NextDrillText"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="NextDrillReasonText"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock x:Name="NextDrillFocusCueText"
                                                   FontSize="11"
                                                   Foreground="#00D4FF"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,8"/>

                                        <!-- CAT_GAME_TRANSFER: what this pattern looks like in
                                             the player's own game. Collapsed unless
                                             GameTransferPhrasing has something specific to say. -->
                                        <Border x:Name="GameTransferBox"
                                                Visibility="Collapsed"
                                                Background="#0F00D4FF"
                                                BorderBrush="#2200D4FF"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,8"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="GameTransferHeader"
                                                           Text="IN YOUR GAME"
                                                           Foreground="#00D4FF"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,3"/>
                                                <TextBlock x:Name="GameTransferText"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="StartPrescribedDrillBtn"
                                                Content="▶  Start This Drill"
                                                Visibility="Collapsed"
                                                Click="StartPrescribedDrill_Click"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="Black"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Padding="12,7"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <!-- Coaching locked overlay — shown for free users -->
                                <Border x:Name="CoachingLockedOverlay"
                                        Background="#CC000000"
                                        CornerRadius="8"
                                        Padding="20,16"
                                        Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="CoachingLockedTitle"
                                                   Text="Your coach spotted something this session"
                                                   Foreground="White"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock x:Name="CoachingLockedHint"
                                                   Text="Upgrade to unlock weaknesses, tips, and drill prescriptions."
                                                   Foreground="#AAAAAA"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"
                                                   MaxWidth="340"/>
                                        <TextBlock x:Name="CoachingTrialProgress"
                                                   Text="" Visibility="Collapsed"
                                                   Foreground="#FFB347"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>
                                        <Button Content="Unlock the full read →"
                                                Click="CoachingUpgrade_Click"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="Black"
                                                BorderThickness="0"
                                                FontSize="13" FontWeight="Bold"
                                                Padding="16,8"
                                                HorizontalAlignment="Center"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </Border>

                                <!-- Motivational close -->
                                <TextBlock x:Name="MotivationalText"
                                           Foreground="{DynamicResource MutedText}"
                                           FontSize="12" FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Error state -->
                            <TextBlock x:Name="CoachingError"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Text="AI coaching unavailable. Check your settings if the problem persists."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ FOOTER BUTTONS ═══ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="0 0 14 14"
                    Padding="24 16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="PlayAgainBtn"
                                Content="▶  Play Again"
                                Click="PlayAgain_Click"
                                Width="140" Height="38"
                                Margin="0,0,10,0"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="Black"
                                FontWeight="Bold"
                                FontSize="13"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Button x:Name="ShareBtn"
                                Content="📤  Share Result"
                                Click="ShareResult_Click"
                                Height="38"
                                Padding="12,0"
                                Background="{DynamicResource CardBackgroundAlt}"
                                Foreground="{DynamicResource PrimaryText}"
                                FontSize="12"
                                BorderThickness="1"
                                BorderBrush="#444"
                                Cursor="Hand"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Content="Close"
                            Click="Close_Click"
                            Width="100" Height="38"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="{DynamicResource MutedText}"
                            FontSize="13"
                            BorderThickness="1"
                            BorderBrush="#333"
                            Cursor="Hand"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
