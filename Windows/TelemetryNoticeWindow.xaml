<Window x:Class="CleanAimTracker.Windows.TelemetryNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A quick note on usage data"
        Width="460" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource AppBackground}"
            CornerRadius="14"
            BorderBrush="#22FFFFFF"
            BorderThickness="1">
        <StackPanel Margin="32 28">

            <TextBlock Text="Anonymous usage data"
                       FontSize="21" FontWeight="Black"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0 0 0 6"/>

            <TextBlock Text="Clean Aim Tracker is made by one person. Knowing which parts get used is the only way I can tell what to fix."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedText}"
                       Margin="0 0 0 20"/>

            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18 14" Margin="0 0 0 12">
                <StackPanel>
                    <TextBlock Text="WHAT IS SENT"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0 0 0 10"/>
                    <TextBlock Text="•  Which drills you play, and at what difficulty"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" TextWrapping="Wrap" Margin="0 0 0 5"/>
                    <TextBlock Text="•  Whether screens like the coach report get opened"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" TextWrapping="Wrap" Margin="0 0 0 5"/>
                    <TextBlock Text="•  A random ID for this install, and the app version"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18 14" Margin="0 0 0 22">
                <StackPanel>
                    <TextBlock Text="WHAT IS NEVER SENT"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0 0 0 10"/>
                    <TextBlock Text="Your scores, accuracy, reaction times, sensitivity or DPI. Your name, email, or Microsoft account. Your computer's name. Nothing that can be traced back to you."
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button x:Name="AcceptBtn"
                    Content="That's fine"
                    Click="Accept_Click"
                    Height="44" BorderThickness="0" Cursor="Hand"
                    Margin="0 0 0 10">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#00D4FF"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="DeclineBtn"
                    Content="No thanks — turn it off"
                    Click="Decline_Click"
                    Height="38"
                    Background="Transparent"
                    Foreground="{DynamicResource MutedText}"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"/>

            <TextBlock Text="You can change this any time in Settings → Privacy."
                       Foreground="{DynamicResource MutedText}"
                       FontSize="11" TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0 8 0 0"/>

        </StackPanel>
    </Border>
</Window>
