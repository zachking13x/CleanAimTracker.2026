<Window x:Class="CleanAimTracker.Windows.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade to Pro"
        Height="760" Width="460"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Border Background="{DynamicResource AppBackground}" Padding="32 28">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="🎯  Unlock your coach"
                       FontSize="22" FontWeight="Black"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 6"/>
            <TextBlock Text="Every session, a coach that tells you exactly what to fix."
                       FontSize="13"
                       Foreground="{DynamicResource MutedText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0 0 0 24"/>

            <!-- AI Coaching preview (blurred) — Feature 8 -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    ClipToBounds="True">
                <Grid>
                    <!-- Fake coaching content behind the overlay -->
                    <StackPanel Opacity="0.35">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🤖  " FontSize="12"/>
                            <TextBlock Text="AI COACH" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Excellent — your reaction time is elite for this scenario."
                                   FontSize="12" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>
                        <TextBlock Text="✅  Flick precision clears the Voltaic advanced threshold  •  Consistent micro-adjustments"
                                   FontSize="11" Foreground="LightGreen" Margin="0,5,0,0"/>
                        <TextBlock Text="💡  Focus on reducing overswing on fast horizontal targets..."
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Lock overlay -->
                    <Border Background="{DynamicResource AppBackground}" Opacity="0.60" CornerRadius="6"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,4">
                        <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="AI Coaching — Pro only"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Feature list -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="20 16" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="WHAT THE COACH DOES FOR YOU"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold"
                               Margin="0 0 0 12"/>

                    <!-- CAT_PRO_EXAMPLES: SHOW the feature, don't list it. A checklist of
                         capabilities asks the reader to imagine the value; a real example
                         of the output IS the value. Every sample below is the actual
                         shape of what CAT produces, in CAT's own voice. -->

                    <TextBlock Text="1 · It names the habit"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <Border Background="#0A0E14" BorderBrush="#22FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0 0 0 14">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#CFD8E3">
                            <Run Text="42% of your clicks land past centre — about 9px long. Your aim arrives clean, but the click commits a hair after the cursor drifts past. That's a timing habit, not a movement one."/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="2 · It prescribes one drill — then checks it"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <Border Background="#0A0E14" BorderBrush="#2200D4FF" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0 0 0 6">
                        <StackPanel>
                            <TextBlock Text="YOUR ACTIVE FIX · SESSION 2 OF 3"
                                       Foreground="#00D4FF" FontSize="9" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBlock Text="Click on arrival, not after"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Overshoot 42% → 31%. It's working."
                                       Foreground="#00E5A0" FontSize="11" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="No other aim trainer comes back and tells you whether the fix worked."
                               Foreground="{DynamicResource MutedText}"
                               FontSize="11" TextWrapping="Wrap" Margin="0 0 0 14"/>

                    <TextBlock Text="3 · It shows you where you stand"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <Border Background="#0A0E14" BorderBrush="#22FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0 0 0 14">
                        <StackPanel>
                            <TextBlock Text="INTERMEDIATE"
                                       Foreground="#00E5A0" FontSize="12" FontWeight="Black"/>
                            <TextBlock Text="Accuracy 74% — next rung is high-intermediate at 78%. You need 4% more."
                                       Foreground="#CFD8E3" FontSize="12"
                                       TextWrapping="Wrap" Margin="0 3 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Also included"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <TextBlock Text="Weekly report  ·  full history and trends  ·  in-game overlay  ·  every scenario and difficulty  ·  data export"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Lifetime button — anchor: show best value first (Feature 11) -->
            <Button x:Name="LifetimeBtn"
                    Click="Lifetime_Click"
                    Height="56"
                    Foreground="Black"
                    FontWeight="Black"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0 0 0 8">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⭐  Unlock forever — " VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock x:Name="LifetimePriceText" Text="$9.99" FontSize="18" FontWeight="Black" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="LifetimeBadgeText" Text="FOUNDER'S PRICE" Foreground="White" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LifetimeCaptionText"
                               Text="One-time · yours forever · never billed again"
                               FontSize="10" FontWeight="Normal"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"
                               Foreground="#333333"/>
                </StackPanel>
            </Button>

            <!-- Monthly button — secondary option -->
            <Button x:Name="ProBtn"
                    Click="Pro_Click"
                    Height="46"
                    Background="#7B2FFF"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="13"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0 0 0 4">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#7B2FFF"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#9B4FFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Or try monthly — " VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock x:Name="MonthlyPriceText" Text="$3.99 / month" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Unlock forever = one-time payment · Monthly renews until cancelled"
                       Foreground="{DynamicResource MutedText}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0 6 0 14"/>

            <!-- Cancel -->
            <Button Content="Remind me after my next session"
                    Click="RemindLater_Click"
                    Height="36"
                    Background="Transparent"
                    Foreground="{DynamicResource MutedText}"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#333"
                    Cursor="Hand"/>

            <!-- Restore purchases -->
            <TextBlock Text="Already purchased? Restore →"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       Margin="0 12 0 0"
                       MouseDown="RestorePurchases_Click"/>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
